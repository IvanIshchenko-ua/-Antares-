{
  "name": "antares-backend",
  "version": "2.0.0",
  "description": "TypeScript Backend API for Antares School Admin Panel",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "watch": "tsc --watch",
    "setup-db": "node setup-db.cjs",
    "test": "jest --runInBand",
    "worker": "ts-node src/workers/fileProcessor.ts",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix"
  },
  "keywords": [
    "typescript",
    "express",
    "api",
    "school",
    "admin"
  ],
  "author": "Ivan Isenko",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.921.0",
    "@aws-sdk/s3-request-presigner": "^3.921.0",
    "bcryptjs": "^3.0.2",
    "bull": "^4.10.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.2.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "mysql2": "^3.15.2",
    "prom-client": "^14.1.1",
    "redis": "^4.7.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.3",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.6",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "eslint": "^8.56.0",
    "jest": "^29.6.1",
    "prettier": "^3.1.1",
    "supertest": "^7.3.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "@tsconfig/node10": "@tsconfig/node16@1.0.2",
    "uuid": "^11.1.1"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
