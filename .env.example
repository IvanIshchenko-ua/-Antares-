# Cloudflare Tunnel Token
CLOUDFLARED_TOKEN=your_cloudflared_token_here

# Allowed CORS Origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:4173,http://127.0.0.1:4173,http://localhost:3001,https://antares-uman.art

# 📱 Telegram Watchdog (Сповіщення на телефон)
# 1. Створіть бота в Telegram через @BotFather (/newbot) та отримайте токен
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# 2. Ваш Telegram Chat ID (напишіть боту або дізнайтесь через @userinfobot)
TELEGRAM_CHAT_ID=123456789

# 📩 Окремий Telegram-бот для заявок на запис
# Створіть іншого бота через @BotFather та вкажіть чат, куди надсилати заявки
SIGNUP_TELEGRAM_BOT_TOKEN=123456789:SignupBotTokenHere
SIGNUP_TELEGRAM_CHAT_ID=123456789

# Інтервал перевірки у секундах (за замовчуванням 30)
CHECK_INTERVAL_SEC=30

# URL публічного сайту для перевірки доступності ззовні
SITE_URL=https://antares-uman.art
